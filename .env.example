# These are read from the process environment. Nothing in this repo loads a
# .env file — export them in your shell, or use `uv run --env-file .env ...`.
# Copy this file to .env if you want somewhere to keep them; .env is gitignored.

# Phase 8 only — cluster labelling and evidence retrieval. Read by the
# Anthropic SDK directly.
export ANTHROPIC_API_KEY=

# Optional: put the data directory somewhere other than ./data (useful when the
# raw snapshot and embeddings do not fit on the repo volume). Must be set
# BEFORE python starts — src.config resolves paths at import time.
# export HARMSCOPE_DATA_DIR=/Volumes/scratch/harmscope
